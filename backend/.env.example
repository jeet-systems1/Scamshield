# App
APP_NAME=ScamShield AI
APP_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite+aiosqlite:///./scamshield.db

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# VirusTotal (free tier: 4 req/min, 500/day)
VIRUSTOTAL_API_KEY=your-virustotal-key-here

# Google Safe Browsing (free)
GOOGLE_SAFE_BROWSING_API_KEY=your-google-key-here

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
